{
  "name": "dsh-ink-panel",
  "version": "1.1.4",
  "description": "Ink-panel comic theme for DeepSeek Harness: ink outlines, hard offset shadows and halftone paper in a day (ricepaper) and night (ink) palette.",
  "type": "module",
  "license": "MIT",
  "author": "brokenheart100",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brokenheart100/dsh-ink-panel.git"
  },
  "homepage": "https://github.com/Brokenheart100/dsh-ink-panel#readme",
  "bugs": {
    "url": "https://github.com/Brokenheart100/dsh-ink-panel/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "skin",
    "comic",
    "ink"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/build.mjs --check && node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
